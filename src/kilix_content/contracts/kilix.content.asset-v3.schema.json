{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kilix.dev/kilix.content.asset/v3",
  "title": "Kilix immutable content asset v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "label", "provider", "stream", "version", "files", "source",
    "sizes", "licenses", "compatibility"
  ],
  "properties": {
    "schema": {"const": "kilix.content.asset/v3"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "stream": {"type": "string", "pattern": "^F[0-9]{3}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 100000,
      "items": {"$ref": "#/$defs/file"}
    },
    "source": {
      "oneOf": [
        {"$ref": "#/$defs/upstreamArchive"},
        {"$ref": "#/$defs/upstreamFiles"},
        {"$ref": "#/$defs/upstreamConvert"},
        {"$ref": "#/$defs/registryManifest"}
      ]
    },
    "sizes": {"$ref": "#/$defs/sizes"},
    "licenses": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/license"}
    },
    "compatibility": {"$ref": "#/$defs/compatibility"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "relativePath": {
      "type": "string", "minLength": 1, "maxLength": 4096,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "httpsUrl": {"type": "string", "pattern": "^https://"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "bytes": {"$ref": "#/$defs/bytes"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["project", "revision", "original_url"],
      "properties": {
        "project": {"type": "string", "minLength": 1, "maxLength": 256},
        "revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "original_url": {"$ref": "#/$defs/httpsUrl"}
      }
    },
    "upstreamArchive": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "url", "archive_bytes", "archive_sha256", "format", "root", "provenance"],
      "properties": {
        "mode": {"const": "upstream-archive"},
        "url": {"$ref": "#/$defs/httpsUrl"},
        "archive_bytes": {"$ref": "#/$defs/bytes"},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "format": {"enum": ["zip", "tar"]},
        "root": {"type": "string", "minLength": 1, "maxLength": 256},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "upstreamFiles": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "fetch", "provenance"],
      "properties": {
        "mode": {"const": "upstream-files"},
        "fetch": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "url"],
            "properties": {
              "path": {"$ref": "#/$defs/relativePath"},
              "url": {"$ref": "#/$defs/httpsUrl"}
            }
          }
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "upstreamConvert": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "input", "conversion", "provenance"],
      "properties": {
        "mode": {"const": "upstream-convert"},
        "input": {
          "type": "object", "additionalProperties": false,
          "required": ["url", "bytes", "sha256"],
          "properties": {
            "url": {"$ref": "#/$defs/httpsUrl"},
            "bytes": {"$ref": "#/$defs/bytes"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "conversion": {
          "type": "object", "additionalProperties": false,
          "required": ["tool_asset_id", "argv"],
          "properties": {
            "tool_asset_id": {"type": "string"},
            "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "registryManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "manifest_url", "manifest_sha256", "blobs", "provenance"],
      "properties": {
        "mode": {"const": "registry-manifest"},
        "manifest_url": {"$ref": "#/$defs/httpsUrl"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "blobs": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "url"],
            "properties": {
              "path": {"$ref": "#/$defs/relativePath"},
              "url": {"$ref": "#/$defs/httpsUrl"}
            }
          }
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "sizes": {
      "type": "object", "additionalProperties": false,
      "required": ["download_bytes", "installed_bytes", "temporary_bytes"],
      "properties": {
        "download_bytes": {"$ref": "#/$defs/bytes"},
        "installed_bytes": {"$ref": "#/$defs/bytes"},
        "temporary_bytes": {"$ref": "#/$defs/bytes"}
      }
    },
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text_sha256", "decision", "licensors", "record_digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "text_sha256": {"$ref": "#/$defs/sha256"},
        "decision": {"enum": ["informational", "affirmative"]},
        "licensors": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "record_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["consumer_schema", "minimum", "maximum"],
      "properties": {
        "consumer_schema": {"type": "string", "minLength": 1, "maxLength": 128},
        "minimum": {"type": "integer", "minimum": 1},
        "maximum": {"type": "integer", "minimum": 1}
      }
    }
  }
}
