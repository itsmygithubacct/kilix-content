{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kilix.dev/kilix.content.asset/v1",
  "title": "Kilix immutable content asset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "label", "provider", "stream", "version", "files", "source",
    "sizes", "licenses", "compatibility"
  ],
  "properties": {
    "schema": {"const": "kilix.content.asset/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 128},
    "label": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 128},
    "stream": {"type": "string", "pattern": "^F[0-9]{3}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 100000,
      "items": {"$ref": "#/$defs/file"}
    },
    "source": {"oneOf": [{"$ref": "#/$defs/mirrored"}, {"$ref": "#/$defs/userSupplied"}]},
    "sizes": {"$ref": "#/$defs/sizes"},
    "licenses": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/license"}
    },
    "compatibility": {"$ref": "#/$defs/compatibility"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "relativePath": {
      "type": "string", "minLength": 1, "maxLength": 4096,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^\\u0000]+$"
    },
    "uri": {"type": "string", "format": "uri", "pattern": "^https://"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "bytes": {"$ref": "#/$defs/bytes"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["project", "revision", "original_url"],
      "properties": {
        "project": {"type": "string", "minLength": 1, "maxLength": 256},
        "revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "original_url": {"$ref": "#/$defs/uri"}
      }
    },
    "mirrored": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "mirrors", "archive_sha256", "provenance"],
      "properties": {
        "mode": {"const": "mirrored"},
        "mirrors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/uri"}},
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "conversion": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_asset_id", "argv"],
      "properties": {
        "tool_asset_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        "argv": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    },
    "userSupplied": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "official_url", "reason", "input_bytes", "input_sha256", "provenance"],
      "properties": {
        "mode": {"const": "user-supplied"},
        "official_url": {"$ref": "#/$defs/uri"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2048},
        "input_bytes": {"$ref": "#/$defs/bytes"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "conversion": {"$ref": "#/$defs/conversion"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "sizes": {
      "type": "object", "additionalProperties": false,
      "required": ["download_bytes", "installed_bytes", "temporary_bytes"],
      "properties": {
        "download_bytes": {"$ref": "#/$defs/bytes"},
        "installed_bytes": {"$ref": "#/$defs/bytes"},
        "temporary_bytes": {"$ref": "#/$defs/bytes"}
      }
    },
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text_sha256", "decision"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "text_sha256": {"$ref": "#/$defs/sha256"},
        "decision": {"enum": ["informational", "affirmative", "user-supplied"]}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["consumer_schema", "minimum", "maximum"],
      "properties": {
        "consumer_schema": {"type": "string", "minLength": 1, "maxLength": 128},
        "minimum": {"type": "integer", "minimum": 1},
        "maximum": {"type": "integer", "minimum": 1}
      }
    }
  }
}
