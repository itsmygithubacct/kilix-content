{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kilix.content.retention-envelope/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "version", "release_id", "intent_digest", "authority_digest", "output_digest", "stable_slot_digest", "profile_digest", "release_schema_digest", "reservation_id", "generation", "target_roles", "components"],
  "properties": {
    "schema": {"const": "kilix.content.retention/v1"},
    "kind": {"const": "envelope"},
    "version": {"type": "integer", "const": 1},
    "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "intent_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stable_slot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_schema_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reservation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "generation": {"type": "integer", "minimum": 1},
    "target_roles": {"type": "array", "const": ["D", "M", "R", "P", "H"]},
    "components": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "path", "descriptor_digest", "content_digest", "bytes", "files", "identity"],
        "properties": {
          "role": {"enum": ["D", "M", "R", "P", "H"]},
          "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,255}$"},
          "descriptor_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "files": {"type": "integer", "minimum": 0},
          "identity": {
            "type": "object", "additionalProperties": false,
            "required": ["type", "uid", "gid", "mode", "fs_magic", "root_id", "mount_id", "role", "path"],
            "properties": {
              "type": {"enum": ["directory", "regular"]},
              "uid": {"type": "integer", "minimum": 0},
              "gid": {"type": "integer", "minimum": 0},
              "mode": {"type": "integer", "minimum": 0},
              "fs_magic": {"type": "string", "minLength": 1},
              "root_id": {"type": "integer", "minimum": 0},
              "mount_id": {"type": "integer", "minimum": 0},
              "role": {"enum": ["D", "M", "R", "P", "H"]},
              "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,255}$"}
            }
          }
        }
      }
    }
  }
}
