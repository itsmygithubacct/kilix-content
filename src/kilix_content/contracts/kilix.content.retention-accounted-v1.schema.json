{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kilix.content.retention-accounted/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "version", "release_id", "intent", "intent_digest", "envelope_digest", "reservation_id", "generation", "state_digest", "stable_slot_digest", "authority_digest", "output_digest", "profile_digest", "ready_journal_generation", "ready_journal_digest", "descriptor_digest", "content_digest", "O_counted", "R_counted", "per_slot_bytes", "per_slot_files", "global_bytes", "global_files", "prospective_bytes", "prospective_files", "capacity_digest", "release_schema_digest", "proof_nonce", "p_path", "p_max_bytes", "p_max_files", "transaction_phase", "capacity_phase"],
  "properties": {
    "schema": {"const": "kilix.content.retention/v1"},
    "kind": {"const": "accounted"},
    "version": {"type": "integer", "const": 1},
    "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["intent_digest", "nonce", "authority_digest", "output_digest", "stable_slot_digest", "profile_digest", "release_schema_digest", "reservation_id", "expected_generation", "target_roles"],
      "properties": {
        "intent_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authority_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stable_slot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "release_schema_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reservation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "expected_generation": {"type": "integer", "minimum": 1},
        "target_roles": {"type": "array", "const": ["D", "M", "R", "P", "H"]}
      }
    },
    "intent_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "envelope_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reservation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "generation": {"type": "integer", "minimum": 1},
    "state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stable_slot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ready_journal_generation": {"type": "integer", "minimum": 1},
    "ready_journal_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "descriptor_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "O_counted": {"type": "array"},
    "R_counted": {"type": "array"},
    "per_slot_bytes": {"type": "integer", "minimum": 0},
    "per_slot_files": {"type": "integer", "minimum": 0},
    "global_bytes": {"type": "integer", "minimum": 0},
    "global_files": {"type": "integer", "minimum": 0},
    "prospective_bytes": {"type": "integer", "minimum": 0},
    "prospective_files": {"type": "integer", "minimum": 0},
    "capacity_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_schema_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proof_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "p_path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,255}$"},
    "p_max_bytes": {"type": "integer", "minimum": 1},
    "p_max_files": {"type": "integer", "minimum": 1},
    "transaction_phase": {"const": "RETENTION_ACCOUNTED"},
    "capacity_phase": {"const": "RETENTION_ACCOUNTED"}
  }
}
