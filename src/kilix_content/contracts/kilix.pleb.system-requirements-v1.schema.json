{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "kilix.pleb.system-requirements/v1", "type": "object", "additionalProperties": false,
  "required": ["schema", "id", "version", "distribution", "architecture", "packages", "manifest_sha256"],
