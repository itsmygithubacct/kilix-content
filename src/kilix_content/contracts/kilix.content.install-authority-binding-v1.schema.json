{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kilix.content.install-authority-binding/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "kind", "stable_slot", "version", "release_id", "catalog_sha256", "authority_digest", "source_digest", "content_ids", "alias_members"],
  "properties": {
    "schema": {"const": "kilix.content.install-authority-binding/v1"},
    "kind": {"enum": ["asset", "content", "package"]},
    "stable_slot": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "version": {"type": "integer", "minimum": 1},
    "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}},
    "alias_members": {"type": "object", "additionalProperties": {"$ref": "#/$defs/member"}}
  },
  "$defs": {"member": {"type": "object", "additionalProperties": false, "required": ["package_id", "member_path"], "properties": {"package_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "member_path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,255}$"}}}}
}
