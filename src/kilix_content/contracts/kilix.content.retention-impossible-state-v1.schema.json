{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "kilix.content.retention-impossible-state/v1", "type": "object", "additionalProperties": false,
  "required": ["schema", "kind", "version", "release_id", "reason_code", "state_digest", "observed", "expected"],
  "properties": {"schema": {"const": "kilix.content.retention/v1"}, "kind": {"const": "impossible"}, "version": {"type": "integer", "const": 1}, "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "reason_code": {"enum": ["predecessor_mismatch", "duplicate_h", "wrong_phase", "name_mismatch", "absence_mismatch", "provenance_mismatch"]}, "state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "observed": {"$ref": "#/$defs/state"}, "expected": {"$ref": "#/$defs/state"}},
  "$defs": {"state": {"type": "object", "additionalProperties": false, "required": ["transaction_phase", "capacity_phase", "generation", "names"], "properties": {"transaction_phase": {"enum": ["RETENTION_PREPARED", "RETENTION_MARKER_DURABLE", "RETENTION_RELATION_DURABLE", "RETENTION_READY", "RETENTION_ACCOUNTED", "RETENTION_HANDOFF_COMPLETE"]}, "capacity_phase": {"enum": ["RETENTION_INTENT_RESERVED", "RETENTION_ACCOUNTED", "RETENTION_HANDOFF_RELEASING", "RETENTION_HANDOFF_PROOFED", "ABSENT"]}, "generation": {"type": "integer", "minimum": 1}, "names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,255}$"}}}}}
}
