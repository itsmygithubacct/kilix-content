{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "kilix.content.sandbox-profile/v1", "type": "object", "additionalProperties": false,
  "required": ["schema", "id", "mount_manifest", "namespace", "capabilities", "seccomp", "resource_limits", "quota_backend"],
  "properties": {"schema": {"const": "kilix.content.sandbox-profile/v1"}, "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "mount_manifest": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source", "target", "read_only", "kind"], "properties": {"source": {"type": "string", "minLength": 1}, "target": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,255}$"}, "read_only": {"type": "boolean"}, "kind": {"enum": ["tmpfs", "proc", "bind", "dev"]}}}}, "namespace": {"type": "object", "additionalProperties": false, "required": ["user", "mount", "pid", "network"], "properties": {"user": {"const": true}, "mount": {"const": true}, "pid": {"const": true}, "network": {"const": true}}}, "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "seccomp": {"type": "object", "additionalProperties": false, "required": ["profile_id", "default_action", "denied_syscalls"], "properties": {"profile_id": {"type": "string", "minLength": 1}, "default_action": {"const": "kill"}, "denied_syscalls": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}, "resource_limits": {"type": "object", "additionalProperties": false, "required": ["memory_bytes", "cpu_seconds", "pids", "tmpfs_bytes", "tmpfs_inodes"], "properties": {"memory_bytes": {"type": "integer", "minimum": 1}, "cpu_seconds": {"type": "integer", "minimum": 1}, "pids": {"type": "integer", "minimum": 1}, "tmpfs_bytes": {"type": "integer", "minimum": 1}, "tmpfs_inodes": {"type": "integer", "minimum": 1}}}, "quota_backend": {"type": "object", "additionalProperties": false, "required": ["kind", "version", "enforced"], "properties": {"kind": {"const": "tmpfs-cgroup"}, "version": {"type": "integer", "const": 1}, "enforced": {"const": true}}}}
}
