{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "kilix.content.toolchain-profile/v1", "type": "object", "additionalProperties": false,
  "required": ["schema", "id", "debian_snapshot", "architecture", "packages", "executables", "libraries", "python", "uv", "environment", "abi"],
  "properties": {"schema": {"const": "kilix.content.toolchain-profile/v1"}, "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "debian_snapshot": {"type": "string", "minLength": 1}, "architecture": {"type": "string", "pattern": "^[a-z0-9_+-]{1,32}$"}, "packages": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["name", "version", "sha256"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}, "executables": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,255}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}, "libraries": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["soname", "sha256"], "properties": {"soname": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}, "python": {"type": "object", "additionalProperties": false, "required": ["implementation", "version", "executable_sha256", "prefix"], "properties": {"implementation": {"const": "CPython"}, "version": {"type": "string", "minLength": 1}, "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "prefix": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,255}$"}}}, "uv": {"type": "object", "additionalProperties": false, "required": ["version", "executable_sha256", "lock_sha256", "offline"], "properties": {"version": {"type": "string", "minLength": 1}, "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "offline": {"const": true}}}, "environment": {"type": "object", "additionalProperties": false, "required": ["allowlist", "assignments"], "properties": {"allowlist": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "assignments": {"type": "object", "additionalProperties": {"type": "string"}}}}, "abi": {"type": "object", "additionalProperties": false, "required": ["libc", "kernel", "endianness"], "properties": {"libc": {"type": "string", "minLength": 1}, "kernel": {"type": "string", "minLength": 1}, "endianness": {"enum": ["little", "big"]}}}}
}
