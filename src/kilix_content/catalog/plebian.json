      "id": "kilix-file",
      "label": "File Manager",
      "kind": "app",
      "icon": "folder",
      "description": "Browse and open files without destructive file operations.",
      "package": "kilix-tui-utils",
      "binary": ".runtime/bin/kilix-file",
      "capabilities": [
        "filesystem-read",
        "open-document"
      ],
      "actions": {
        "browse": {
          "description": "Browse files and directories"
        },
        "open": {
          "argv": [
            "--open"
          ],
          "accepts_input": true,
          "description": "Open a document through the shared host dispatcher"
        }
      },
      "accepts": [
        "inode/directory",
        "text/plain",
        "application/pdf",
        "image/*"
      ],
      "launch": {
        "mode": "terminal",
        "preferred_size": "900x600"
