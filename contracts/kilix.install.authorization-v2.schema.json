{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kilix.install.authorization/v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "authorization_id", "authority_digest", "output_digest", "decision", "release_id", "catalog_sha256"],
  "properties": {
    "schema": {"const": "kilix.install.authorization/v2"}, "authorization_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "authority_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "decision": {"enum": ["informational", "affirmative", "user-supplied"]}, "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
