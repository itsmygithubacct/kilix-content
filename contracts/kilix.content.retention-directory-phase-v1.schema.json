{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kilix.content.retention-directory-phase/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "version", "release_id", "directory"],
  "properties": {
    "schema": {"const": "kilix.content.retention/v1"},
    "kind": {"const": "directory-phase"},
    "version": {"type": "integer", "const": 1},
    "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "directory": {
      "type": "object", "additionalProperties": false,
      "required": ["directory_id", "role", "parent_path", "path", "final_name", "temp_name", "phase", "baseline_children", "baseline_children_digest", "observed_children", "permitted_children", "phase_child_set_digest", "identity", "absence_evidence"],
      "properties": {
        "directory_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "role": {"enum": ["D", "M", "R", "P", "H"]},
        "parent_path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,255}$"},
        "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,255}$"},
        "final_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,255}$"},
        "temp_name": {"type": "string", "pattern": "^\\.new-retention-[a-z0-9][a-z0-9._-]{0,240}$"},
        "phase": {"enum": ["RETENTION_PREPARED", "RETENTION_MARKER_DURABLE", "RETENTION_RELATION_DURABLE", "RETENTION_READY", "RETENTION_ACCOUNTED", "RETENTION_HANDOFF_RELEASING", "RETENTION_HANDOFF_PROOFED", "RETENTION_HANDOFF_COMPLETE", "ABSENT"]},
        "baseline_children": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,255}$"}},
        "baseline_children_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observed_children": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:[a-z0-9][a-z0-9._-]{0,255}|\\.new-retention-[a-z0-9][a-z0-9._-]{0,240})$"}},
        "permitted_children": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,255}$"}},
        "phase_child_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "identity": {"type": "object", "additionalProperties": false, "required": ["type", "uid", "gid", "mode", "fs_magic", "root_id", "mount_id", "role", "path"], "properties": {"type": {"const": "directory"}, "uid": {"type": "integer", "minimum": 0}, "gid": {"type": "integer", "minimum": 0}, "mode": {"type": "integer", "minimum": 0}, "fs_magic": {"type": "string", "minLength": 1}, "root_id": {"type": "integer", "minimum": 0}, "mount_id": {"type": "integer", "minimum": 0}, "role": {"enum": ["D", "M", "R", "P", "H"]}, "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,255}$"}}},
        "absence_evidence": {"type": "object", "additionalProperties": false, "required": ["before_final", "after_parent_fsync"], "properties": {"before_final": {"type": "boolean"}, "after_parent_fsync": {"type": "boolean"}}}
      }
    }
  }
}
