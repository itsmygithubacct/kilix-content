{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kilix.dev/kilix.install.license/v1",
  "title": "Kilix license decision or retained receipt",
  "oneOf": [{"$ref": "#/$defs/decision"}, {"$ref": "#/$defs/receipt"}],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifactIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 128}
    },
    "base": {
      "type": "object",
      "required": ["schema", "kind", "decision_class", "license_id", "license_text_sha256", "artifact_ids", "release"],
      "properties": {
        "schema": {"const": "kilix.install.license/v1"},
        "kind": {"enum": ["decision", "receipt"]},
        "decision_class": {"enum": ["informational", "affirmative", "user-supplied", "restricted"]},
        "license_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "license_text_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_ids": {"$ref": "#/$defs/artifactIds"},
        "release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"}
      }
    },
    "decision": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["schema", "kind", "decision_class", "license_id", "license_text_sha256", "artifact_ids", "release", "presenter", "outcome"],
          "properties": {
            "schema": true, "kind": {"const": "decision"}, "decision_class": true,
            "license_id": true, "license_text_sha256": true, "artifact_ids": true, "release": true,
            "presenter": {"type": "string", "minLength": 1, "maxLength": 128},
            "outcome": {"enum": ["record", "accept", "decline", "supply"]},
            "upstream_url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "input_sha256": {"$ref": "#/$defs/sha256"}
          },
          "allOf": [
            {"if": {"properties": {"decision_class": {"const": "informational"}}}, "then": {"properties": {"outcome": {"const": "record"}}}},
            {"if": {"properties": {"decision_class": {"const": "affirmative"}}}, "then": {"properties": {"outcome": {"enum": ["accept", "decline"]}}}},
            {"if": {"properties": {"decision_class": {"const": "user-supplied"}}}, "then": {"required": ["upstream_url", "input_sha256"], "properties": {"outcome": {"const": "supply"}}}},
            {"if": {"properties": {"decision_class": {"const": "restricted"}}}, "then": {"properties": {"outcome": {"const": "decline"}}}}
          ]
        }
      ]
    },
    "receipt": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["schema", "kind", "decision_class", "license_id", "license_text_sha256", "artifact_ids", "release", "local_user", "recorded_at", "outcome"],
          "properties": {
            "schema": true, "kind": {"const": "receipt"}, "decision_class": true,
            "license_id": true, "license_text_sha256": true, "artifact_ids": true, "release": true,
            "local_user": {"type": "string", "minLength": 1, "maxLength": 256},
            "recorded_at": {"type": "string", "format": "date-time"},
            "outcome": {"enum": ["recorded", "accepted", "supplied"]},
            "presenter": {"type": "string", "minLength": 1, "maxLength": 128},
            "upstream_url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "input_sha256": {"$ref": "#/$defs/sha256"}
          },
          "allOf": [
            {"if": {"properties": {"decision_class": {"const": "informational"}}}, "then": {"properties": {"outcome": {"const": "recorded"}}}},
            {"if": {"properties": {"decision_class": {"const": "affirmative"}}}, "then": {"required": ["presenter"], "properties": {"outcome": {"const": "accepted"}}}},
            {"if": {"properties": {"decision_class": {"const": "user-supplied"}}}, "then": {"required": ["upstream_url", "input_sha256"], "properties": {"outcome": {"const": "supplied"}}}},
            {"if": {"properties": {"decision_class": {"const": "restricted"}}}, "then": false}
          ]
        }
      ]
    }
  }
}
