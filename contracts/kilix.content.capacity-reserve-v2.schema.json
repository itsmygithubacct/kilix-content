{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "kilix.content.capacity-reserve/v2", "type": "object", "additionalProperties": false,
  "required": ["schema", "release_id", "authority_digest", "hardware_tier", "tier_inputs", "root_roles", "phase_maxima", "retention_limits", "reservation", "stable_lock", "generation_zero", "mutable_generations", "reservation_tombstone", "ordinary_release_proof", "filesystem_key"],
  "properties": {
    "schema": {"const": "kilix.content.capacity-reserve/v2"}, "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "authority_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "hardware_tier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "tier_inputs": {"type": "object"},
    "root_roles": {"type": "object", "additionalProperties": false, "required": ["installed-data", "resumable-cache", "transaction-state", "license-receipts-v1", "install-authorizations-v2"], "properties": {"installed-data": {"$ref": "#/$defs/root"}, "resumable-cache": {"$ref": "#/$defs/root"}, "transaction-state": {"$ref": "#/$defs/root"}, "license-receipts-v1": {"$ref": "#/$defs/root"}, "install-authorizations-v2": {"$ref": "#/$defs/root"}}},
    "phase_maxima": {"type": "object", "additionalProperties": {"$ref": "#/$defs/phase"}}, "retention_limits": {"$ref": "#/$defs/limits"}, "reservation": {"$ref": "#/$defs/reservation"},
    "stable_lock": {"type": "object", "additionalProperties": false, "required": ["schema", "path", "generation", "inode_digest", "authority_digest", "state_digest"], "properties": {"schema": {"const": "kilix.content.capacity-lock/v1"}, "path": {"type": "string", "minLength": 1}, "generation": {"type": "integer", "minimum": 0}, "inode_digest": {"$ref": "#/$defs/digest"}, "authority_digest": {"$ref": "#/$defs/digest"}, "state_digest": {"$ref": "#/$defs/digest"}}},
    "generation_zero": {"type": "object", "additionalProperties": false, "required": ["generation", "state", "state_digest"], "properties": {"generation": {"const": 0}, "state": {"const": "ABSENT"}, "state_digest": {"$ref": "#/$defs/digest"}}},
    "mutable_generations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["generation", "state", "state_digest", "predecessor_digest"], "properties": {"generation": {"type": "integer", "minimum": 1}, "state": {"enum": ["RESERVED", "ACCOUNTED", "RELEASING", "PROOFED", "TOMBSTONED"]}, "state_digest": {"$ref": "#/$defs/digest"}, "predecessor_digest": {"$ref": "#/$defs/digest"}}}},
    "reservation_tombstone": {"type": "object", "additionalProperties": false, "required": ["schema", "reservation_id", "generation", "state", "digest", "absent_after"], "properties": {"schema": {"const": "kilix.content.reservation-tombstone/v1"}, "reservation_id": {"type": "string", "minLength": 1}, "generation": {"type": "integer", "minimum": 1}, "state": {"const": "RELEASED"}, "digest": {"$ref": "#/$defs/digest"}, "absent_after": {"const": true}}},
    "ordinary_release_proof": {"type": "object", "additionalProperties": false, "required": ["schema", "kind", "release_kind", "proof_digest", "reservation_id", "generation", "resources", "permanent"], "properties": {"schema": {"const": "kilix.content.release-proof/v1"}, "kind": {"const": "release-proof"}, "release_kind": {"const": "ordinary"}, "proof_digest": {"$ref": "#/$defs/digest"}, "reservation_id": {"type": "string", "minLength": 1}, "generation": {"type": "integer", "minimum": 1}, "resources": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "permanent": {"const": false}}},
    "filesystem_key": {"type": "object", "additionalProperties": false, "required": ["magic", "mount_id", "device", "root_id", "key_digest"], "properties": {"magic": {"type": "string", "minLength": 1}, "mount_id": {"type": "integer", "minimum": 0}, "device": {"type": "integer", "minimum": 0}, "root_id": {"type": "integer", "minimum": 0}, "key_digest": {"$ref": "#/$defs/digest"}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "positive": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "root": {"type": "object", "additionalProperties": false, "required": ["relative_path", "fs_magic", "descriptor_relative"], "properties": {"relative_path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,255}$"}, "fs_magic": {"type": "string", "minLength": 1}, "descriptor_relative": {"type": "boolean"}}},
    "phase": {"type": "object", "additionalProperties": false, "required": ["bytes", "inodes", "temporary_files"], "properties": {"bytes": {"$ref": "#/$defs/positive"}, "inodes": {"$ref": "#/$defs/positive"}, "temporary_files": {"$ref": "#/$defs/positive"}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["per_slot", "global", "objects", "relations"], "properties": {"per_slot": {"$ref": "#/$defs/positive"}, "global": {"$ref": "#/$defs/positive"}, "objects": {"$ref": "#/$defs/positive"}, "relations": {"$ref": "#/$defs/positive"}}},
    "reservation": {"type": "object", "additionalProperties": false, "required": ["memory_bytes", "disk_bytes", "inode_count"], "properties": {"memory_bytes": {"$ref": "#/$defs/positive"}, "disk_bytes": {"$ref": "#/$defs/positive"}, "inode_count": {"$ref": "#/$defs/positive"}}}
  }
}
