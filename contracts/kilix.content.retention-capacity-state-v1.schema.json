{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "kilix.content.retention-capacity-state/v1", "type": "object", "additionalProperties": false,
  "required": ["schema", "kind", "version", "release_id", "capacity_phase", "generation", "intent_digest", "authority_digest", "output_digest", "stable_slot_digest", "reservation_id", "predecessor_digest", "state_digest", "reservation_path", "tombstone_path", "proof_path", "absence"],
  "properties": {"schema": {"const": "kilix.content.retention/v1"}, "kind": {"const": "capacity-state"}, "version": {"type": "integer", "const": 1}, "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "capacity_phase": {"enum": ["RETENTION_INTENT_RESERVED", "RETENTION_ACCOUNTED", "RETENTION_HANDOFF_RELEASING", "RETENTION_HANDOFF_PROOFED", "ABSENT"]}, "generation": {"type": "integer", "minimum": 1}, "intent_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "authority_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "stable_slot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "reservation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}, "predecessor_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "reservation_path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,255}$"}, "tombstone_path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,255}$"}, "proof_path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,255}$"}, "absence": {"type": "object", "additionalProperties": false, "required": ["reservation", "tombstone", "proof"], "properties": {"reservation": {"type": "boolean"}, "tombstone": {"type": "boolean"}, "proof": {"type": "boolean"}}}}
}
